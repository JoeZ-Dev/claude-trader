{
  "permissions": {
    "allow": [
      "Read(./**)",
      "Write(./**)",
      "Edit(./**)",
      "Bash(git:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(pip:*)",
      "Bash(pytest:*)",
      "Bash(docker:*)",
      "Bash(docker-compose:*)",
      "Bash(curl localhost:*)",
      "Bash(curl 127.0.0.1:*)",
      "Read(../ToS_Companion/**)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(rm:*)"
    ],
    "deny": [
      "Write(../**)",
      "Edit(../**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Bash(git push --force*)",
      "Bash(rm -rf /*)"
    ],
    "additionalDirectories": [
      "../ToS_Companion"
    ],
    "defaultMode": "default"
  }
}
